+import asyncio
+import time
+import threading
+from datetime import datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.base import MessageEvent, SendResult
+from gateway.run import GatewayRunner, _natural_stop_scope
+from gateway.session import SessionEntry, SessionSource, build_session_key
+from tools import async_delegation as ad
+
+
+def _source():
+    return SessionSource(
+        platform=Platform.TELEGRAM,
+        chat_id="42",
+        chat_type="dm",
+        user_id="7",
+    )
+
+
+class _MenuAdapter:
+    def __init__(self):
+        self.kwargs = None
+
+    async def send_stop_menu(self, **kwargs):
+        self.kwargs = kwargs
+        return SendResult(success=True, message_id="10")
+
+
+def _runner(adapter):
+    source = _source()
+    entry = SessionEntry(
+        session_key=build_session_key(source),
+        session_id="parent-1",
+        created_at=datetime.now(),
+        updated_at=datetime.now(),
+        platform=Platform.TELEGRAM,
+        chat_type="dm",
+    )
+    runner = object.__new__(GatewayRunner)
+    runner._running_agents = {}
+    runner._running_agents_ts = {}
+    runner._background_tasks = set()
+    runner.session_store = MagicMock()
+    runner.session_store.get_or_create_session.return_value = entry
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    runner._thread_metadata_for_source = lambda *args, **kwargs: None
+    runner._reply_anchor_for_event = lambda event: None
+    runner._is_user_authorized = lambda source: True
+    return runner, entry
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    ad._reset_for_tests()
+    yield
+    ad._reset_for_tests()
+
+
+def test_stop_command_shows_owned_delegation_and_button_cancels_it():
+    async def run():
+        adapter = _MenuAdapter()
+        runner, entry = _runner(adapter)
+        gate = threading.Event()
+        interrupted = threading.Event()
+        dispatched = ad.dispatch_async_delegation(
+        goal="audit current project",
+        context=None,
+        toolsets=None,
+        role="leaf",
+        model="m",
+        session_key=entry.session_key,
+        parent_session_id=entry.session_id,
+        runner=lambda: {} if gate.wait(timeout=2) else {},
+        interrupt_fn=interrupted.set,
+    )
+        event = MessageEvent(text="/stop", source=_source(), message_id="m1")
+        try:
+            response = await runner._handle_stop_command(event)
+            assert response is None
+            assert adapter.kwargs is not None
+            items = adapter.kwargs["items"]
+            assert [(item["kind"], item["id"]) for item in items] == [
+                ("delegation", dispatched["delegation_id"])
+            ]
+
+            result = await adapter.kwargs["on_stop_selected"](items[0]["target"])
+            assert "Stopped" in result
+            assert interrupted.wait(1)
+        finally:
+            gate.set()
+
+    asyncio.run(run())
+
+
+def test_busy_stop_opens_menu_instead_of_immediate_interrupt():
+    async def run():
+        adapter = _MenuAdapter()
+        runner, entry = _runner(adapter)
+        runner._running_agents[entry.session_key] = SimpleNamespace(session_id="parent-1")
+        runner._interrupt_and_clear_session = AsyncMock()
+
+        event = MessageEvent(text="/stop", source=_source(), message_id="m1")
+        response = await runner._busy_stop_command(

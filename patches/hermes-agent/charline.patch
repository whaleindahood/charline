--- /dev/null
+++ b/tests/gateway/test_plugin_action_card.py
@@ -0,0 +1,73 @@
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def _query(data="pl:example:42:projects", user_id="42", thread_id=77):
+    query = MagicMock()
+    query.data = data
+    query.from_user = SimpleNamespace(id=user_id, first_name="User")
+    query.message = SimpleNamespace(
+        chat_id=123,
+        message_id=9,
+        message_thread_id=thread_id,
+        chat=SimpleNamespace(type="private"),
+    )
+    query.answer = AsyncMock()
+    query.edit_message_text = AsyncMock()
+    return query
+
+
+def _adapter():
+    adapter = object.__new__(TelegramAdapter)
+    adapter._is_callback_user_authorized = lambda *args, **kwargs: True
+    adapter.format_message = lambda text: text
+    adapter.build_source = lambda **kwargs: SimpleNamespace(**kwargs)
+    adapter._platform_event_handler = AsyncMock(return_value=[{
+        "plugin": "example",
+        "card": {
+            "text": "Проекты",
+            "buttons": [[{"label": "Назад", "action": "home"}]],
+        },
+    }])
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_plugin_card_navigation_is_reconstructable_and_edits_in_place():
+    adapter = _adapter()
+    query = _query()
+
+    await adapter._handle_plugin_card_callback(query, query.data)
+
+    adapter._platform_event_handler.assert_awaited_once()
+    event, source = adapter._platform_event_handler.await_args.args
+    assert event["payload"]["thread_id"] == "77"
+    assert source.thread_id == "77"
+    query.edit_message_text.assert_awaited_once()
+    query.answer.assert_awaited_once_with()
+
+
+@pytest.mark.asyncio
+async def test_plugin_card_rejects_another_authorized_user():
+    adapter = _adapter()
+    query = _query(user_id="99")
+
+    await adapter._handle_plugin_card_callback(query, query.data)
+
+    query.answer.assert_awaited_once_with(text="Это действие недоступно.")
+    adapter._platform_event_handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_plugin_card_missing_view_is_user_facing():
+    adapter = _adapter()
+    adapter._platform_event_handler = AsyncMock(return_value=[])
+    query = _query()
+
+    await adapter._handle_plugin_card_callback(query, query.data)
+
+    query.answer.assert_awaited_once_with(text="Не удалось открыть этот раздел.")

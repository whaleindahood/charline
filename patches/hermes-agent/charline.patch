+from __future__ import annotations
+
+import pytest
+
+from tools import approval
+
+
+WRITE_COMMANDS = (
+    "python google_api.py gmail send --to a@example.com --subject Hi --body Hello",
+    "python google_api.py gmail reply msg-1 --body Thanks",
+    "python google_api.py gmail modify msg-1 --add-label STARRED",
+    "python google_api.py calendar create --summary Meet --start a --end b",
+    "python google_api.py calendar delete event-1",
+    "python google_api.py drive upload report.pdf",
+    "python google_api.py drive create-folder Reports",
+    "python google_api.py drive share file-1 --email a@example.com",
+    "python google_api.py drive delete file-1",
+    "python google_api.py sheets update sheet-1 A1 --values '[[1]]'",
+    "python google_api.py sheets append sheet-1 A1 --values '[[1]]'",
+    "python google_api.py sheets create Budget",
+    "python google_api.py docs create --title Notes",
+    "python google_api.py docs append doc-1 --body More",
+)
+
+
+@pytest.mark.parametrize("command", WRITE_COMMANDS)
+def test_workspace_writes_are_dangerous(command):
+    dangerous, _key, description = approval.detect_dangerous_command(command)
+    assert dangerous is True
+    assert description == "Google Workspace write"
+
+
+@pytest.mark.parametrize(
+    "command",
+    (
+        "python google_api.py gmail search is:unread",
+        "python google_api.py gmail get msg-1",
+        "python google_api.py calendar list",
+        "python google_api.py drive search report",
+        "python google_api.py drive get file-1",
+        "python google_api.py drive download file-1",
+        "python google_api.py sheets get sheet-1 A1",
+        "python google_api.py docs get doc-1",
+    ),
+)
+def test_workspace_reads_are_not_dangerous(command):
+    dangerous, _key, _description = approval.detect_dangerous_command(command)
+    assert dangerous is False
+
+
+@pytest.mark.parametrize("mode", ["smart", "off"])
+def test_workspace_write_always_requires_one_human_decision(monkeypatch, mode):
+    session_key = f"workspace-{mode}"
+    monkeypatch.setenv("HERMES_SESSION_KEY", session_key)
+    monkeypatch.setenv("HERMES_EXEC_ASK", "1")
+    monkeypatch.delenv("HERMES_CRON_SESSION", raising=False)
+    monkeypatch.setattr(approval, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setattr(approval, "is_current_session_yolo_enabled", lambda: False)
+    monkeypatch.setattr(approval, "_get_approval_config", lambda: {"mode": mode})
+    monkeypatch.setattr(
+        "tools.tirith_security.check_command_security",
+        lambda _command: {"action": "allow", "findings": [], "summary": ""},
+    )
+    smart_calls = []
+    monkeypatch.setattr(approval, "_smart_approve", lambda *_: smart_calls.append(True) or "approve")
+    captured = {}
+
+    def decide(_session_key, _notify, data, *, surface):
+        captured.update(data)
+        return {"resolved": True, "choice": "once", "reason": None}
+
+    monkeypatch.setattr(approval, "_await_gateway_decision", decide)
+    approval.register_gateway_notify(session_key, lambda _data: None)
+    try:
+        result = approval.check_all_command_guards(WRITE_COMMANDS[0], "local")
+    finally:
+        approval.unregister_gateway_notify(session_key)
+        approval.clear_session(session_key)
+
+    assert result["approved"] is True
+    assert result["user_approved"] is True
+    assert smart_calls == []
+    assert captured["allow_session"] is False
+    assert captured["allow_permanent"] is False
+
+
+def test_owned_gateway_approval_rejects_other_user():
+    session_key = "shared-approval"
+    entry = approval._ApprovalEntry({"owner_user_id": "7"})
+    with approval._lock:
+        approval._gateway_queues[session_key] = [entry]
+    try:
+        assert approval.resolve_gateway_approval(
+            session_key, "once", actor_user_id="8"
+        ) == 0
+        assert not entry.event.is_set()
+        assert approval.resolve_gateway_approval(
+            session_key, "once", actor_user_id="7"
+        ) == 1
+        assert entry.event.is_set()
+    finally:
+        with approval._lock:
+            approval._gateway_queues.pop(session_key, None)

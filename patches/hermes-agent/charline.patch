+def list_recent_async_delegations_for_session(
+    session_key: str = "",
+    origin_ui_session_id: str = "",
+    parent_session_id: str = "",
+    *,
+    limit: int = 5,
+) -> List[Dict[str, Any]]:
+    """Recent terminal delegation results owned by one session."""
+    selectors = []
+    params: List[Any] = []
+    for column, value in (
+        ("origin_session", session_key),
+        ("origin_ui_session_id", origin_ui_session_id),
+        ("parent_session_id", parent_session_id),
+    ):
+        if value:
+            selectors.append(f"{column} = ?")
+            params.append(str(value))
+    if not selectors:
+        return []
+    bounded_limit = max(1, min(int(limit), 20))
+    with _DB_LOCK, _transaction() as conn:
+        rows = conn.execute(
+            "SELECT delegation_id, state, dispatched_at, completed_at, "
+            "result_json, task_json FROM async_delegations "
+            "WHERE state NOT IN ('running', 'stalling', 'finalizing') AND ("
+            + " OR ".join(selectors)
+            + ") ORDER BY completed_at DESC, updated_at DESC LIMIT ?",
+            (*params, bounded_limit),
+        ).fetchall()
+
+    recent = []
+    for delegation_id, state, dispatched_at, completed_at, result_json, task_json in rows:
+        try:
+            result = json.loads(result_json) if result_json else {}
+        except (TypeError, ValueError):
+            result = {}
+        try:
+            task = json.loads(task_json) if task_json else {}
+        except (TypeError, ValueError):
+            task = {}
+        summaries = []
+        for child in result.get("results") or []:
+            if isinstance(child, dict):
+                text = child.get("summary") or child.get("error")
+                if text:
+                    summaries.append(str(text))
+        recent.append(
+            {
+                "delegation_id": str(delegation_id),
+                "goal": str(task.get("goal") or "Background task"),
+                "status": str(state),
+                "duration_seconds": max(
+                    0, int((completed_at or dispatched_at) - dispatched_at)
+                ),
+                "summary": str(result.get("summary") or "\n\n".join(summaries)),
+                "error": str(result.get("error") or ""),
+            }
+        )
+    return recent
+

+                "thread_id": str(thread_id or ""),
+                "message_id": str(message.message_id),
+                "created_at": time.monotonic(),
+                "callback": on_action,
+            }
+            return SendResult(success=True, message_id=str(message.message_id))
+        except Exception as exc:
+            logger.warning(
+                "[%s] send_charline_menu failed: %s",
+                self.name,
+                _redact_telegram_error_text(exc),
+            )
+            return SendResult(success=False, error=_redact_telegram_error_text(exc))
+
+    async def send_stop_menu(
+        self,
+        chat_id: str,
+        session_key: str,
+        items: list,
+        on_stop_selected,
+        on_refresh=None,
+        owner_user_id: str = "",
+        metadata: Optional[Dict[str, Any]] = None,
+    ) -> SendResult:
+        """Render current-session work with native refresh and stop controls."""
+        if not self._bot:
+            return SendResult(success=False, error="Not connected")
+        from agent.i18n import get_language
+
+        russian = get_language() == "ru"
+        menu_id = secrets.token_hex(4)
+        visible_items = list(items[:12])
+        text, keyboard = self._render_task_center(
+            menu_id, visible_items, russian=russian, refresh=on_refresh is not None
+        )
+        try:
+            kwargs: Dict[str, Any] = {
+                "chat_id": normalize_telegram_chat_id(chat_id),
+                "text": text,
+                "parse_mode": ParseMode.HTML,
+                "reply_markup": keyboard,
+                **self._link_preview_kwargs(),
+            }
+            thread_id = self._metadata_thread_id(metadata)
+            reply_to_id = self._reply_to_message_id_for_send(None, metadata)
+            kwargs["reply_to_message_id"] = reply_to_id
+            kwargs.update(
+                self._thread_kwargs_for_send(
+                    chat_id,
+                    thread_id,
+                    metadata,
+                    reply_to_message_id=reply_to_id,
+                )
+            )
+            message = await self._send_message_with_thread_fallback(**kwargs)
+            for stale_id, stale in list(self._stop_menu_state.items()):
+                if stale.get("session_key") == session_key:
+                    self._stop_menu_state.pop(stale_id, None)
+            self._stop_menu_state[menu_id] = {
+                "session_key": session_key,
+                "owner_user_id": str(owner_user_id or ""),
+                "items": visible_items,
+                "callback": on_stop_selected,
+                "on_refresh": on_refresh,
+                "russian": russian,
+            }
+            return SendResult(success=True, message_id=str(message.message_id))
+        except Exception as exc:
+            logger.warning(
+                "[%s] send_stop_menu failed: %s",
+                self.name,
+                _redact_telegram_error_text(exc),
+            )
+            return SendResult(success=False, error=_redact_telegram_error_text(exc))
+
+    @staticmethod
+    def _render_task_center(
+        menu_id: str,
+        items: list,
+        *,
+        russian: bool,
+        refresh: bool,
+        notice: str = "",
+    ) -> tuple[str, Any]:
+        lines = [f"<b>{'Задачи' if russian else 'Tasks'}</b>", ""]
+        rows = []
+        kind_labels = {
+            "agent": "ответ" if russian else "answer",
+            "process": "процесс" if russian else "process",
+            "delegation": "фоновая задача" if russian else "background task",
+        }
+        state_labels = {
+            "starting": "запускается" if russian else "starting",
+            "running": "выполняется" if russian else "running",
+            "stalling": "нет прогресса" if russian else "no progress",
+            "finalizing": "завершается" if russian else "finishing",
+            "needs_input": "нужен ответ" if russian else "needs input",
+            "completed": "готово" if russian else "ready",
+            "success": "готово" if russian else "ready",
+            "error": "ошибка" if russian else "error",
+            "failed": "ошибка" if russian else "error",
+            "timeout": "таймаут" if russian else "timeout",
+            "interrupted": "отменено" if russian else "cancelled",
+            "cancelled": "отменено" if russian else "cancelled",
+            "stalled": "зависло" if russian else "stalled",
+            "unknown": "неизвестно" if russian else "unknown",
+        }
+        if notice:
+            lines.extend([f"<i>{_html.escape(notice)}</i>", ""])
+        if not items:
+            lines.append("Нет активных задач." if russian else "No active tasks.")
+        for index, item in enumerate(items):
+            raw_kind = str(item.get("kind") or "task")
+            label = str(item.get("label") or "task")
+            if raw_kind == "agent":
+                label = "Текущий ответ" if russian else "Current response"
+            kind = kind_labels.get(raw_kind, "задача" if russian else "task")
+            state = state_labels.get(
+                str(item.get("state") or "running"),
+                str(item.get("state") or "running"),
+            )
+            elapsed = int(item.get("elapsed", 0) or 0)
+            duration = f" · {elapsed // 60}м" if russian and elapsed >= 60 else ""
+            if not russian and elapsed >= 60:
+                duration = f" · {elapsed // 60}m"
+            lines.append(
+                f"{index + 1}. <b>{_html.escape(label)}</b>\n"
+                f"   <code>{_html.escape(kind)} · {_html.escape(state)}{duration}</code>"
+            )
+            if item.get("detail"):
+                rows.append([
+                    InlineKeyboardButton(
+                        f"{'Результат' if russian else 'Result'} {index + 1}",
+                        callback_data=f"st:{menu_id}:detail:{index}",
+                    )
+                ])
+            else:
+                rows.append([
+                    InlineKeyboardButton(
+                        (
+                            f"Остановить {index + 1}: {label[:34]}"
+                            if russian
+                            else f"Stop {index + 1}: {label[:34]}"
+                        ),
+                        callback_data=f"st:{menu_id}:{index}",
+                    )
+                ])
+        controls = []
+        if refresh:
+            controls.append(
+                InlineKeyboardButton(
+                    "Обновить" if russian else "Refresh",
+                    callback_data=f"st:{menu_id}:refresh",
+                )
+            )
+        if any(item.get("target") for item in items):
+            controls.append(
+                InlineKeyboardButton(
+                    "Остановить всё" if russian else "Stop all",
+                    callback_data=f"st:{menu_id}:all",
+                )
+            )
+        if controls:
+            rows.append(controls)
+        return "\n".join(lines), InlineKeyboardMarkup(rows) if rows else None
+

+import json
+import threading
+import time
+
+import pytest
+
+from tools import async_delegation as ad
+from tools.delegate_tool import delegate_task
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    ad._reset_for_tests()
+    yield
+    ad._reset_for_tests()
+
+
+def _dispatch(session_key: str, parent_session_id: str):
+    gate = threading.Event()
+    interrupted = threading.Event()
+    result = ad.dispatch_async_delegation(
+        goal="read-only audit",
+        context=None,
+        toolsets=None,
+        role="leaf",
+        model="m",
+        session_key=session_key,
+        parent_session_id=parent_session_id,
+        runner=lambda: {} if gate.wait(timeout=2) else {},
+        interrupt_fn=interrupted.set,
+    )
+    return result, gate, interrupted
+
+
+def test_interrupt_delegation_is_scoped_to_owning_session():
+    own, own_gate, own_interrupted = _dispatch("chat:one", "parent-one")
+    other, other_gate, other_interrupted = _dispatch("chat:two", "parent-two")
+    try:
+        stopped = ad.interrupt_delegation(
+            own["delegation_id"],
+            session_key="chat:one",
+            reason="user_stop",
+        )
+        assert stopped is True
+        assert own_interrupted.wait(1)
+        assert not other_interrupted.is_set()
+
+        denied = ad.interrupt_delegation(
+            other["delegation_id"],
+            session_key="chat:one",
+            reason="user_stop",
+        )
+        assert denied is False
+        assert not other_interrupted.is_set()
+    finally:
+        own_gate.set()
+        other_gate.set()
+
+
+def test_delegate_task_lists_and_cancels_current_session_work(monkeypatch):
+    result, gate, interrupted = _dispatch("chat:one", "parent-one")
+
+    class Parent:
+        session_id = "parent-one"
+
+    monkeypatch.setattr(
+        "tools.approval.get_current_session_key", lambda default="": "chat:one"
+    )
+    try:
+        listed = json.loads(delegate_task(action="list", parent_agent=Parent()))
+        assert [row["delegation_id"] for row in listed["delegations"]] == [
+            result["delegation_id"]
+        ]
+
+        cancelled = json.loads(
+            delegate_task(
+                action="cancel",
+                delegation_id=result["delegation_id"],
+                parent_agent=Parent(),
+            )
+        )
+        assert cancelled == {
+            "status": "cancelled",
+            "delegation_id": result["delegation_id"],
+        }
+        assert interrupted.wait(1)
+    finally:
+        gate.set()
+
+
+def test_recent_delegations_are_scoped_and_expose_result_summary(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setattr(ad, "_db_path", lambda: tmp_path / "state.db")
+    now = time.time()
+    with ad._transaction() as conn:
+        conn.execute(
+            """INSERT INTO async_delegations
+               (delegation_id, origin_session, parent_session_id, state,
+                dispatched_at, completed_at, updated_at, result_json,
+                task_json, delivery_state)
+               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
+            (
+                "deleg_done",
+                "chat:one",
+                "parent-one",
+                "completed",
+                now - 12,
+                now,
+                now,
+                json.dumps({"summary": "Ready."}),
+                json.dumps({"goal": "prepare launch"}),
+                "delivered",
+            ),
+        )
+
+    rows = ad.list_recent_async_delegations_for_session(
+        session_key="chat:one", parent_session_id="parent-one"
+    )
+
+    assert rows == [
+        {
+            "delegation_id": "deleg_done",
+            "goal": "prepare launch",
+            "status": "completed",
+            "duration_seconds": 12,
+            "summary": "Ready.",
+            "error": "",
+        }
+    ]
+    assert ad.list_recent_async_delegations_for_session(
+        session_key="chat:other"
+    ) == []

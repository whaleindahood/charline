+def test_natural_stop_with_delegation_id_cancels_only_that_task():
+    async def run():
+        adapter = _MenuAdapter()
+        runner, entry = _runner(adapter)
+        gate = threading.Event()
+        first_interrupted = threading.Event()
+        second_interrupted = threading.Event()
+        first = ad.dispatch_async_delegation(
+            goal="first audit",
+            context=None,
+            toolsets=None,
+            role="leaf",
+            model="m",
+            session_key=entry.session_key,
+            parent_session_id=entry.session_id,
+            runner=lambda: {} if gate.wait(timeout=2) else {},
+            interrupt_fn=first_interrupted.set,
+        )
+        ad.dispatch_async_delegation(
+            goal="second audit",
+            context=None,
+            toolsets=None,
+            role="leaf",
+            model="m",
+            session_key=entry.session_key,
+            parent_session_id=entry.session_id,
+            runner=lambda: {} if gate.wait(timeout=2) else {},
+            interrupt_fn=second_interrupted.set,
+        )
+        event = MessageEvent(
+            text=f"Останови {first['delegation_id']}",
+            source=_source(),
+            message_id="m1",
+        )
+        try:
+            response = await runner._handle_natural_stop_request(
+                event, entry.session_key, "menu"
+            )
+            assert response == f"Stopped delegation {first['delegation_id']}."
+            assert first_interrupted.wait(1)
+            assert not second_interrupted.is_set()
+            assert adapter.kwargs is None
+        finally:
+            gate.set()
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("Останови работу", "menu"),

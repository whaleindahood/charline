     return normalized in _CONTROL_INTERRUPT_MESSAGES
 
 
+_NATURAL_STOP_RE = re.compile(
+    r"^\s*(?:(?:пожалуйста|please)[,\s]+)?(?:"
+    r"(?:останови(?:те)?|остановить|отмени(?:те)?|отменить|"
+    r"прекрати(?:те)?|прекратить|stop|cancel|terminate)\b|"
+    r"(?:можешь|можете|надо|нужно|хочу|хотел(?:а)?\s+бы)\s+"
+    r"(?:остановить|отменить|прекратить)\b|"
+    r"(?:заверши(?:те)?|завершить)\b(?=.*\b(?:все|всё)\b)"
+    r")",
+    re.IGNORECASE,
+)
+_NATURAL_STOP_ALL_RE = re.compile(
+    r"\b(?:все|всё|всех|all|everything)\b", re.IGNORECASE
+)
+_NATURAL_STOP_TARGET_RE = re.compile(
+    r"\b(?:задач\w*|процесс\w*|работ\w*|агент\w*|делегац\w*|"
+    r"tasks?|process(?:es)?|jobs?|agents?|delegations?|deleg_[\w-]+)\b",
+    re.IGNORECASE,
+)
+
+
+def _natural_stop_scope(text: Optional[str]) -> Optional[str]:
+    """Recognize only explicit imperative cancellation, never discussion."""
+    normalized = " ".join(str(text or "").split())
+    match = _NATURAL_STOP_RE.search(normalized)
+    if not normalized or not match:
+        return None
+    tail = normalized[match.end():].strip(" ,.:;!?")
+    if not tail:
+        return "menu"
+    all_scope = bool(_NATURAL_STOP_ALL_RE.search(tail))
+    without_all = _NATURAL_STOP_ALL_RE.sub("", tail).strip(" ,.:;!?")
+    if all_scope and not without_all:
+        return "all"
+    if not _NATURAL_STOP_TARGET_RE.search(tail):
+        return None
+    return "all" if all_scope else "menu"
+

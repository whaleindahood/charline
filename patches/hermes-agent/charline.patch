+import asyncio
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import MessageEvent, SendResult
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from hermes_cli.commands import resolve_command, should_bypass_active_session
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def _source(thread_id=None):
+    return SessionSource(
+        platform=Platform.TELEGRAM,
+        chat_id="42",
+        chat_type="dm",
+        user_id="7",
+        thread_id=thread_id,
+    )
+
+
+def _adapter():
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="test-token"))
+    adapter._bot = AsyncMock()
+    adapter._bot.send_message = AsyncMock(return_value=MagicMock(message_id=99))
+    return adapter
+
+
+def _query(data, *, user_id="7", thread_id=None):
+    query = AsyncMock()
+    query.data = data
+    query.message = MagicMock(
+        chat_id=42,
+        text="Charline",
+        message_id=99,
+        message_thread_id=thread_id,
+    )
+    query.message.chat.type = "private"
+    query.from_user = MagicMock(id=user_id, first_name="Tester")
+    return query
+
+
+def _telegram_buttons():
+    return (
+        patch(
+            "plugins.platforms.telegram.adapter.InlineKeyboardButton",
+            side_effect=lambda text, callback_data: SimpleNamespace(
+                text=text, callback_data=callback_data
+            ),
+        ),
+        patch(
+            "plugins.platforms.telegram.adapter.InlineKeyboardMarkup",
+            side_effect=lambda rows: SimpleNamespace(inline_keyboard=rows),
+        ),
+    )
+
+
+def test_charline_command_is_native_and_available_while_busy():
+    command = resolve_command("charline")
+    assert command is not None
+    assert command.gateway_only is True
+    assert command.busy_policy == "dispatch"
+    assert should_bypass_active_session("charline") is True
+
+
+def test_charline_panel_renders_six_requested_buttons():
+    async def run():
+        adapter = _adapter()
+        button_patch, markup_patch = _telegram_buttons()
+        with button_patch, markup_patch:
+            result = await adapter.send_charline_menu(
+                chat_id="42",
+                session_key="telegram:dm:42",
+                owner_user_id="7",
+                on_action=AsyncMock(),
+            )
+
+        assert result.success
+        assert len(adapter._charline_menu_state) == 1
+        sent = adapter._bot.send_message.await_args.kwargs
+        labels = [
+            button.text
+            for row in sent["reply_markup"].inline_keyboard
+            for button in row
+        ]
+        assert labels == [
+            "Календарь",
+            "Почта",
+            "Файлы",

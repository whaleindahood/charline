+
+def test_stop_menu_renders_each_target_and_stop_all():
+    async def run():
+        adapter = _adapter()
+        message = MagicMock(message_id=99)
+        adapter._bot.send_message = AsyncMock(return_value=message)
+        callback = AsyncMock(return_value="Stopped delegation deleg_1")
+
+        result = await adapter.send_stop_menu(
+        chat_id="42",
+        session_key="chat:42",
+        items=[
+            {
+                "kind": "delegation",
+                "id": "deleg_1",
+                "target": "delegation|deleg_1",
+                "label": "audit",
+            },
+            {
+                "kind": "process",
+                "id": "proc-1",
+                "target": "process|proc-1",
+                "label": "pytest",
+            },
+        ],
+        on_stop_selected=callback,
+    )
+
+        assert result.success
+        assert len(adapter._stop_menu_state) == 1
+        sent = adapter._bot.send_message.await_args.kwargs
+        assert "audit" in sent["text"]
+        assert "pytest" in sent["text"]
+        assert "deleg_1" not in sent["text"]
+        assert "proc-1" not in sent["text"]
+        assert sent["reply_markup"] is not None
+
+    asyncio.run(run())

@@ -0,0 +1,137 @@
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from gateway.config import Platform
+from gateway.platforms.base import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from hermes_cli.commands import resolve_command
+
+
+def _source(thread_id=None):
+    return SessionSource(
+        platform=Platform.TELEGRAM,
+        chat_id="42",
+        chat_type="dm",
+        user_id="7",
+        thread_id=thread_id,
+    )
+
+
+def test_projects_command_is_registered_for_gateway():
+    command = resolve_command("projects")
+    assert command is not None
+    assert command.gateway_only is True
+    assert command.busy_policy == "dispatch"
+
+
+def test_projects_center_keeps_topic_mode_opt_in():
+    async def run():
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=False)
+        )
+
+        result = await runner._handle_projects_command(
+            MessageEvent(text="/projects", source=_source(), message_id="m1")
+        )
+
+        assert "/topic" in result
+        assert "not enabled" in result.lower()
+
+    asyncio.run(run())
+
+
+def test_projects_center_lists_owned_topic_sessions_and_task_counts():
+    async def run():
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=True),
+            list_telegram_topic_bindings_for_chat=AsyncMock(
+                return_value=[
+                    {
+                        "thread_id": "101",
+                        "session_id": "session-a",
+                        "session_key": "telegram:dm:42:101",
+                        "user_id": "7",
+                    },
+                    {
+                        "thread_id": "202",
+                        "session_id": "session-b",
+                        "session_key": "telegram:dm:42:202",
+                        "user_id": "other-user",
+                    },
+                ]
+            ),
+            get_session_title=AsyncMock(return_value="Launch plan"),
+        )
+        runner._collect_stop_menu_items = lambda session_key, parent: [
+            {"target": "delegation|1"}
+        ]
+
+        result = await runner._handle_projects_command(
+            MessageEvent(text="/projects", source=_source("101"), message_id="m1")
+        )
+
+        assert "Launch plan" in result
+        assert "Active tasks: 1" in result
+        assert "current" in result.lower()
+        assert "session-b" not in result
+

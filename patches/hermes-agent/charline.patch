+        message=SimpleNamespace(
+            chat_id=123,
+            message_thread_id=thread_id,
+            chat=SimpleNamespace(type="private"),
+        ),
+        answer=AsyncMock(),
+        edit_message_text=AsyncMock(),
+    )
+
+
+@pytest.mark.asyncio
+async def test_choice_picker_is_scoped_to_owner_and_thread() -> None:
+    adapter = object.__new__(TelegramAdapter)
+    adapter._choice_picker_state = {
+        "123:77": {
+            "choices": [{"value": "projects"}],
+            "owner_user_id": "42",
+            "on_choice_selected": AsyncMock(return_value="ok"),
+        }
+    }
+    adapter._is_callback_user_authorized = lambda *args, **kwargs: True
+
+    wrong_owner = _query(user_id="99", thread_id="77")
+    await adapter._handle_choice_picker_callback(wrong_owner, "cp:0", "123")
+    wrong_owner.answer.assert_awaited_once_with(
+        text="⛔ This menu belongs to another user."
+    )
+    assert "123:77" in adapter._choice_picker_state
+
+    wrong_thread = _query(user_id="42", thread_id="88")
+    await adapter._handle_choice_picker_callback(wrong_thread, "cp:0", "123")
+    wrong_thread.answer.assert_awaited_once_with(
+        text="Picker expired — run the command again."
+    )
+
+    owner = _query(user_id="42", thread_id="77")
+    await adapter._handle_choice_picker_callback(owner, "cp:0", "123")
+    assert "123:77" not in adapter._choice_picker_state
+
+
+def test_choice_picker_root_and_project_have_distinct_keys() -> None:
+    assert TelegramAdapter._choice_picker_key("123") == "123:"

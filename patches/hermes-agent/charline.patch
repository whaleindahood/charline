+def interrupt_delegation(delegation_id: str, session_key: str = "") -> bool:
+    """Interrupt one live delegation, optionally proving its owning session."""
+    with _records_lock:
+        record = _records.get(str(delegation_id))
+        if (
+            not record
+            or record.get("status") not in ("running", "stalling")
+            or (session_key and str(record.get("session_key") or "") != session_key)
+        ):
+            return False
+        interrupt_fn = record.get("interrupt_fn")
+    if not callable(interrupt_fn):
+        return False
+    try:
+        interrupt_fn()
+        return True
+    except Exception as exc:
+        logger.debug("interrupt_delegation: %s failed: %s", delegation_id, exc)
+        return False
+

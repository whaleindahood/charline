+        )
+
+        assert await runner._handle_projects_command(event) == "created"
+        runner._create_telegram_project.assert_awaited_once_with(event, "Research")
+
+    asyncio.run(run())
+
+
+def test_projects_new_does_not_write_when_topic_mode_is_disabled():
+    async def run():
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=False)
+        )
+        runner._create_telegram_project = AsyncMock()
+        event = MessageEvent(text="/projects new", source=_source(), message_id="m1")
+
+        result = await runner._handle_projects_command(event)
+
+        assert "/topic" in result
+        runner._create_telegram_project.assert_not_awaited()
+
+    asyncio.run(run())
+
+
+def test_projects_center_lists_owned_topic_sessions_and_task_counts():
+    async def run():
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=True),
+            list_telegram_topic_bindings_for_chat=AsyncMock(
+                return_value=[
+                    {
+                        "thread_id": "101",
+                        "session_id": "session-a",
+                        "session_key": "telegram:dm:42:101",
+                        "user_id": "7",
+                    },
+                    {
+                        "thread_id": "202",
+                        "session_id": "session-b",
+                        "session_key": "telegram:dm:42:202",
+                        "user_id": "other-user",
+                    },
+                ]
+            ),
+            get_session_title=AsyncMock(return_value="Launch plan"),
+        )
+        runner._collect_stop_menu_items = lambda session_key, parent: [
+            {"target": "delegation|1"}
+        ]
+
+        result = await runner._handle_projects_command(
+            MessageEvent(text="/projects", source=_source("101"), message_id="m1")
+        )
+
+        assert "Launch plan" in result
+        assert "Active tasks: 1" in result
+        assert "current" in result.lower()
+        assert "session-b" not in result
+
+    asyncio.run(run())
+
+
+def test_projects_center_paginates_before_title_and_task_lookups():
+    async def run():
+        bindings = [
+            {
+                "thread_id": str(index),
+                "session_id": f"session-{index}",
+                "session_key": f"telegram:dm:42:{index}",
+                "user_id": "7",
+            }
+            for index in range(1, 26)
+        ]
+        db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=True),
+            list_telegram_topic_bindings_for_chat=AsyncMock(return_value=bindings),
+            get_session_title=AsyncMock(
+                side_effect=lambda session_id: f"Title {session_id.split('-')[-1]}"
+            ),
+        )
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = db
+        looked_up = []
+        runner._collect_stop_menu_items = lambda session_key, parent: looked_up.append(
+            session_key
+        ) or []
+
+        result = await runner._handle_projects_command(
+            MessageEvent(text="/projects 2", source=_source(), message_id="m1")
+        )
+
+        assert "11. `Title 11`" in result
+        assert "20. `Title 20`" in result
+        assert "Title 10" not in result
+        assert "Title 21" not in result
+        assert "Page 2/3" in result
+        assert db.get_session_title.await_count == 10
+        assert len(looked_up) == 10
+
+    asyncio.run(run())
+
+
+def test_projects_center_rejects_invalid_page():
+    async def run():
+        runner = object.__new__(GatewayRunner)
+        runner._session_db = SimpleNamespace(
+            is_telegram_topic_mode_enabled=AsyncMock(return_value=True),
+            list_telegram_topic_bindings_for_chat=AsyncMock(return_value=[]),
+        )
+        result = await runner._handle_projects_command(
+            MessageEvent(text="/projects nope", source=_source(), message_id="m1")
+        )
+        assert "Usage: /projects [page]" in result
+
+    asyncio.run(run())
